# OpenAI-Schluessel aus dem Projekt mit Region Europa. Nie committen.
OPENAI_API_KEY=
# Optional: Projekt-ID, falls der Schluessel mehreren Projekten zugeordnet ist
OPENAI_PROJECT_ID=
# Region fuer die Datenverarbeitung (offizielle SDK-Option dataResidency): eu, us oder global
IKNOW_DATA_RESIDENCY=eu
# Zugangscode fuer das Testlabor. In Production Pflicht, sonst antwortet die API nicht.
IKNOW_ACCESS_CODE=
# 1 = Probelauf ohne Modell (vorgefertigte Antworten), z. B. ohne Schluessel
IKNOW_MOCK=

# Wissen hinter dem Zahnrad / Knopf "Wissen"
# BLOB_READ_WRITE_TOKEN setzt Vercel automatisch, wenn ein Blob-Speicher (privat) mit dem Projekt verbunden wird.
BLOB_READ_WRITE_TOKEN=
# Passwort zum Ergänzen und Löschen von Wissen
IKNOW_EDIT_PASSWORD=
